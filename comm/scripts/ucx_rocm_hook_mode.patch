+    ucs_status_t status;
+    void *func_ptr;
+    int count;
+
+    if (*installed_hooks_p & UCS_BIT(mode)) {
+        return UCS_OK;
+    }
+
+    if (!(ucm_global_opts.rocm_hook_modes & UCS_BIT(mode))) {
+        /* Disabled by configuration */
+        ucm_debug("rocm memory hooks mode %s is disabled",
+                  ucm_mmap_hook_modes[mode]);
+        return UCS_OK;
+    }
