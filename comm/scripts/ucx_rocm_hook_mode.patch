+#define UCM_BISTRO_X86_MOV_GV_EV 0x8B
+
+/* ENDBR64 (CET landing pad): F3 0F 1E FA */
+#define UCM_BISTRO_X86_ENDBR64_B0 0xF3
+#define UCM_BISTRO_X86_ENDBR64_B1 0x0F
