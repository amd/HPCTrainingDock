+        (((const uint8_t*)ctx->src_p)[2]             == UCM_BISTRO_X86_ENDBR64_B3)) {
+        /* endbr64 (CET landing pad) - position independent, copy verbatim */
+        ucs_serialize_next(&ctx->src_p, const uint8_t); /* 0x0F */
