+    count = 0;
+    for (func = ucm_rocm_funcs; func->patch.symbol != NULL; ++func) {
+        func_ptr = ucm_reloc_get_orig(func->patch.symbol, func->patch.value);
+        if (func_ptr == NULL) {
+            /* Symbol not (yet) loaded - e.g. libhsa-runtime64 not mapped */
+            continue;
+        }
