             }
         }
+    } else if ((rex == UCM_BISTRO_X86_REX_W) &&
+               (opcode == UCM_BISTRO_X86_MOV_GV_EV)) {
+        modrm = *ucs_serialize_next(&ctx->src_p, const uint8_t);
+        /* Handle RIP-relative load "mov disp32(%rip), %reg" (mod=00, r/m=101).
